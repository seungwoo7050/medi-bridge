{
  "name": "@medi-bridge/extension",
  "description": "네이버 지도 위 통합 비급여·이벤트 의료 가격 비교 Chrome MV3 확장프로그램",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@medi-bridge/parsers": "workspace:*",
    "@medi-bridge/shared": "workspace:*",
    "@medi-bridge/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wxt": "^0.21.5"
  }
}
