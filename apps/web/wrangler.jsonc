{
  "name": "medi-bridge",
  "main": "./cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./.cf-dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/intro", "/intro/*", "/vat", "/vat/*", "/privacy", "/privacy/*"]
  }
}
