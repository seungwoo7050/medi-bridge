{
  "name": "@medi-bridge/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "build:cf": "next build && node scripts/build-cf-bundle.mjs",
    "deploy:cf": "pnpm run build:cf && npx --yes wrangler@4.146.0 deploy",
    "start": "next start -p 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@medi-bridge/shared": "workspace:*",
    "@medi-bridge/ui": "workspace:*",
    "lucide-react": "^0.487.0",
    "next": "^16.3.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
