{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "apps/**/src/**",
      "apps/**/tests/**",
      "apps/**/e2e/**",
      "apps/extension/wxt.config.ts",
      "apps/extension/vitest.config.ts",
      "apps/extension/playwright.config.ts",
      "apps/web/next.config.ts",
      "apps/web/vitest.config.ts",
      "apps/web/playwright.config.ts",
      "apps/web/cloudflare/**",
      "apps/web/scripts/**",
      "packages/**/src/**",
      "packages/**/tests/**",
      "packages/**/vitest.config.ts",
      "!**/.next",
      "!**/.turbo",
      "!**/.wxt",
      "!**/.cf-dist",
      "!**/.wrangler",
      "!**/output",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "useConst": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["apps/extension/**"],
      "linter": {
        "rules": {
          "performance": {
            "noImgElement": "off"
          }
        }
      }
    }
  ]
}
