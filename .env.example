# PostgreSQL (optional: falls back to local normalized seed dataset when unset)
DATABASE_URL=

# 공공데이터포털 건강보험심사평가원(HIRA) API 인증키 (선택: 배치 동기화 워커용)
HIRA_SERVICE_KEY=

# 자체 웹 동적 지도 SDK 키 (선택: 미설정 시 내장 좌표 핀 맵 자동 동작)
NEXT_PUBLIC_KAKAO_MAP_KEY=
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# Chrome 확장이 호출할 자체 백엔드 베이스 URL (기본값: http://localhost:3000)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
