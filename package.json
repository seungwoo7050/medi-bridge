{
  "name": "medi-bridge",
  "description": "네이버 지도 위 전국 병원 실시간 비급여·리뷰 브릿지 Chrome 확장프로그램 및 안내 웹",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:ext": "pnpm --filter @medi-bridge/extension dev",
    "dev:web": "pnpm --filter @medi-bridge/web dev",
    "build": "turbo run build",
    "zip:ext": "pnpm --filter @medi-bridge/extension zip",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @medi-bridge/extension test:e2e && pnpm --filter @medi-bridge/web test:e2e",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.13.0",
    "turbo": "^2.5.4",
    "typescript": "^5.8.2",
    "vitest": "^4.1.0"
  }
}
